<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.handover.mapper.JnHandoverMapper">

    <resultMap id="JnHandoverResult" type="com.jn.erp.production.handover.domain.JnHandover">
        <id property="handoverId" column="handover_id"/>
        <result property="handoverNo" column="handover_no"/>
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="fromOperationId" column="from_operation_id"/>
        <result property="fromOperationCode" column="from_operation_code"/>
        <result property="fromOperationName" column="from_operation_name"/>
        <result property="toOperationId" column="to_operation_id"/>
        <result property="toOperationCode" column="to_operation_code"/>
        <result property="toOperationName" column="to_operation_name"/>
        <result property="fromWorkCenterId" column="from_work_center_id"/>
        <result property="toWorkCenterId" column="to_work_center_id"/>
        <result property="fromWorker" column="from_worker"/>
        <result property="toWorker" column="to_worker"/>
        <result property="quantity" column="quantity"/>
        <result property="defectQty" column="defect_qty"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectHandoverVo">
        SELECT handover_id, handover_no, order_id, order_no,
               from_operation_id, from_operation_code, from_operation_name,
               to_operation_id, to_operation_code, to_operation_name,
               from_work_center_id, to_work_center_id,
               from_worker, to_worker, quantity, defect_qty, status, remark,
               create_by, create_time, update_by, update_time
        FROM jn_handover
    </sql>

    <select id="selectByOrderId" parameterType="Long" resultMap="JnHandoverResult">
        <include refid="selectHandoverVo"/>
        WHERE order_id = #{orderId}
        ORDER BY create_time ASC
    </select>

</mapper>
