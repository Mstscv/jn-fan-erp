<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.routing.mapper.JnRoutingMapper">

    <resultMap id="JnRoutingResult" type="com.jn.erp.production.routing.domain.JnRouting">
        <id property="routingId" column="routing_id"/>
        <result property="routingCode" column="routing_code"/>
        <result property="routingName" column="routing_name"/>
        <result property="productId" column="product_id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="productSpec" column="product_spec"/>
        <result property="version" column="version"/>
        <result property="status" column="status"/>
        <result property="totalLeadTime" column="total_lead_time"/>
        <result property="isActive" column="is_active"/>
        <result property="approveBy" column="approve_by"/>
        <result property="approveTime" column="approve_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectRoutingVo">
        SELECT routing_id, routing_code, routing_name, product_id, product_code,
               product_name, product_spec, version, status, total_lead_time,
               is_active, approve_by, approve_time,
               create_by, create_time, update_by, update_time, remark
        FROM jn_routing
    </sql>

    <select id="selectByProductId" parameterType="Long" resultMap="JnRoutingResult">
        <include refid="selectRoutingVo"/>
        WHERE product_id = #{productId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByRoutingCode" parameterType="String" resultMap="JnRoutingResult">
        <include refid="selectRoutingVo"/>
        WHERE routing_code = #{routingCode}
    </select>

</mapper>
