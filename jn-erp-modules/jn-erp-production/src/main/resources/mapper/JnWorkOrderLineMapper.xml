<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.workorder.mapper.JnWorkOrderLineMapper">

    <resultMap id="JnWorkOrderLineResult" type="com.jn.erp.production.workorder.domain.JnWorkOrderLine">
        <id property="lineId" column="line_id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="spec" column="spec"/>
        <result property="quantity" column="quantity"/>
        <result property="unit" column="unit"/>
        <result property="bomId" column="bom_id"/>
        <result property="bomVersion" column="bom_version"/>
        <result property="routingId" column="routing_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectWorkOrderLineVo">
        SELECT line_id, order_id, product_id, product_code, product_name, spec,
               quantity, unit, bom_id, bom_version, routing_id, sort_order,
               create_by, create_time, update_by, update_time
        FROM jn_work_order_line
    </sql>

    <select id="selectByOrderId" parameterType="Long" resultMap="JnWorkOrderLineResult">
        <include refid="selectWorkOrderLineVo"/>
        WHERE order_id = #{orderId}
        ORDER BY sort_order ASC
    </select>

    <delete id="deleteByOrderId" parameterType="Long">
        DELETE FROM jn_work_order_line WHERE order_id = #{orderId}
    </delete>

</mapper>
