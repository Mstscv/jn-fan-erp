<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.outsource.mapper.JnOutsourceOrderMapper">

    <resultMap id="JnOutsourceOrderResult" type="com.jn.erp.production.outsource.domain.JnOutsourceOrder">
        <id property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="supplierContact" column="supplier_contact"/>
        <result property="supplierPhone" column="supplier_phone"/>
        <result property="processType" column="process_type"/>
        <result property="productId" column="product_id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="productSpec" column="product_spec"/>
        <result property="orderQty" column="order_qty"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="deliveryDate" column="delivery_date"/>
        <result property="orderDate" column="order_date"/>
        <result property="qualityRequirement" column="quality_requirement"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectOrderVo">
        SELECT order_id, order_no, supplier_id, supplier_name, supplier_contact, supplier_phone,
               process_type, product_id, product_code, product_name, product_spec,
               order_qty, unit_price, total_amount, delivery_date, order_date,
               quality_requirement, status, remark,
               create_by, create_time, update_by, update_time
        FROM jn_outsource_order
    </sql>

    <select id="selectBySupplier" parameterType="Long" resultMap="JnOutsourceOrderResult">
        <include refid="selectOrderVo"/>
        WHERE supplier_id = #{supplierId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" parameterType="String" resultMap="JnOutsourceOrderResult">
        <include refid="selectOrderVo"/>
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

</mapper>
