<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.outsource.mapper.JnOutsourceOrderLineMapper">

    <resultMap id="JnOutsourceOrderLineResult" type="com.jn.erp.production.outsource.domain.JnOutsourceOrderLine">
        <id property="lineId" column="line_id"/>
        <result property="orderId" column="order_id"/>
        <result property="materialId" column="material_id"/>
        <result property="materialCode" column="material_code"/>
        <result property="materialName" column="material_name"/>
        <result property="spec" column="spec"/>
        <result property="unit" column="unit"/>
        <result property="dispatchQty" column="dispatch_qty"/>
        <result property="receivedQty" column="received_qty"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="lineTotal" column="line_total"/>
        <result property="remark" column="remark"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectLineVo">
        SELECT line_id, order_id, material_id, material_code, material_name, spec, unit,
               dispatch_qty, received_qty, unit_price, line_total, remark, sort_order,
               create_by, create_time, update_by, update_time
        FROM jn_outsource_order_line
    </sql>

    <select id="selectByOrderId" parameterType="Long" resultMap="JnOutsourceOrderLineResult">
        <include refid="selectLineVo"/>
        WHERE order_id = #{orderId}
        ORDER BY sort_order ASC
    </select>

    <delete id="deleteByOrderId" parameterType="Long">
        DELETE FROM jn_outsource_order_line WHERE order_id = #{orderId}
    </delete>

</mapper>
