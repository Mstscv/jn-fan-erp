<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.workorder.mapper.JnWorkOrderMapper">

    <resultMap id="JnWorkOrderResult" type="com.jn.erp.production.workorder.domain.JnWorkOrder">
        <id property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="productId" column="product_id"/>
        <result property="productCode" column="product_code"/>
        <result property="productName" column="product_name"/>
        <result property="productSpec" column="product_spec"/>
        <result property="quantity" column="quantity"/>
        <result property="unit" column="unit"/>
        <result property="bomId" column="bom_id"/>
        <result property="bomVersion" column="bom_version"/>
        <result property="routingId" column="routing_id"/>
        <result property="salesOrderId" column="sales_order_id"/>
        <result property="salesOrderNo" column="sales_order_no"/>
        <result property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="priority" column="priority"/>
        <result property="plannedStart" column="planned_start"/>
        <result property="plannedEnd" column="planned_end"/>
        <result property="actualStart" column="actual_start"/>
        <result property="actualEnd" column="actual_end"/>
        <result property="status" column="status"/>
        <result property="totalCost" column="total_cost"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectWorkOrderVo">
        SELECT order_id, order_no, product_id, product_code, product_name, product_spec,
               quantity, unit, bom_id, bom_version, routing_id,
               sales_order_id, sales_order_no, customer_id, customer_name,
               priority, planned_start, planned_end, actual_start, actual_end,
               status, total_cost, remark,
               create_by, create_time, update_by, update_time
        FROM jn_work_order
    </sql>

    <select id="selectByStatus" parameterType="String" resultMap="JnWorkOrderResult">
        <include refid="selectWorkOrderVo"/>
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <select id="selectPendingScheduling" resultMap="JnWorkOrderResult">
        <include refid="selectWorkOrderVo"/>
        WHERE status = 'PENDING'
        ORDER BY priority ASC, planned_start ASC
    </select>

</mapper>
