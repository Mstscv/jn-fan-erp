<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.outsource.mapper.JnOutsourceDispatchLineMapper">

    <resultMap id="JnOutsourceDispatchLineResult" type="com.jn.erp.production.outsource.domain.JnOutsourceDispatchLine">
        <id property="lineId" column="line_id"/>
        <result property="dispatchId" column="dispatch_id"/>
        <result property="orderLineId" column="order_line_id"/>
        <result property="materialId" column="material_id"/>
        <result property="materialCode" column="material_code"/>
        <result property="materialName" column="material_name"/>
        <result property="spec" column="spec"/>
        <result property="unit" column="unit"/>
        <result property="qty" column="qty"/>
        <result property="batchNo" column="batch_no"/>
        <result property="remark" column="remark"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectDispatchLineVo">
        SELECT line_id, dispatch_id, order_line_id, material_id, material_code, material_name,
               spec, unit, qty, batch_no, remark, sort_order,
               create_by, create_time, update_by, update_time
        FROM jn_outsource_dispatch_line
    </sql>

    <select id="selectByDispatchId" parameterType="Long" resultMap="JnOutsourceDispatchLineResult">
        <include refid="selectDispatchLineVo"/>
        WHERE dispatch_id = #{dispatchId}
        ORDER BY sort_order ASC
    </select>

    <delete id="deleteByDispatchId" parameterType="Long">
        DELETE FROM jn_outsource_dispatch_line WHERE dispatch_id = #{dispatchId}
    </delete>

</mapper>
