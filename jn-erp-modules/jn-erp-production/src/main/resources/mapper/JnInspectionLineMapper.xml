<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.quality.mapper.JnInspectionLineMapper">

    <resultMap id="JnInspectionLineResult" type="com.jn.erp.production.quality.domain.JnInspectionLine">
        <id property="lineId" column="line_id"/>
        <result property="inspectionId" column="inspection_id"/>
        <result property="standardId" column="standard_id"/>
        <result property="checkItem" column="check_item"/>
        <result property="specValue" column="spec_value"/>
        <result property="upperLimit" column="upper_limit"/>
        <result property="lowerLimit" column="lower_limit"/>
        <result property="actualValue" column="actual_value"/>
        <result property="result" column="result"/>
        <result property="defectQty" column="defect_qty"/>
        <result property="remark" column="remark"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectInspectionLineVo">
        SELECT line_id, inspection_id, standard_id, check_item, spec_value,
               upper_limit, lower_limit, actual_value, result, defect_qty, remark, sort_order,
               create_by, create_time, update_by, update_time
        FROM jn_inspection_line
    </sql>

    <select id="selectByInspectionId" parameterType="Long" resultMap="JnInspectionLineResult">
        <include refid="selectInspectionLineVo"/>
        WHERE inspection_id = #{inspectionId}
        ORDER BY sort_order ASC
    </select>

    <delete id="deleteByInspectionId" parameterType="Long">
        DELETE FROM jn_inspection_line WHERE inspection_id = #{inspectionId}
    </delete>

</mapper>
