<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.production.quality.mapper.JnInspectionMapper">

    <resultMap id="JnInspectionResult" type="com.jn.erp.production.quality.domain.JnInspection">
        <id property="inspectionId" column="inspection_id"/>
        <result property="inspectionNo" column="inspection_no"/>
        <result property="inspectionType" column="inspection_type"/>
        <result property="sourceOrderId" column="source_order_id"/>
        <result property="sourceOrderNo" column="source_order_no"/>
        <result property="sourceOrderLineId" column="source_order_line_id"/>
        <result property="materialId" column="material_id"/>
        <result property="materialCode" column="material_code"/>
        <result property="materialName" column="material_name"/>
        <result property="spec" column="spec"/>
        <result property="batchNo" column="batch_no"/>
        <result property="inspector" column="inspector"/>
        <result property="inspectionDate" column="inspection_date"/>
        <result property="sampleQty" column="sample_qty"/>
        <result property="passQty" column="pass_qty"/>
        <result property="rejectQty" column="reject_qty"/>
        <result property="result" column="result"/>
        <result property="status" column="status"/>
        <result property="defectDesc" column="defect_desc"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectInspectionVo">
        SELECT inspection_id, inspection_no, inspection_type,
               source_order_id, source_order_no, source_order_line_id,
               material_id, material_code, material_name, spec, batch_no,
               inspector, inspection_date, sample_qty, pass_qty, reject_qty,
               result, status, defect_desc, remark,
               create_by, create_time, update_by, update_time
        FROM jn_inspection
    </sql>

    <select id="selectBySourceOrder" parameterType="Long" resultMap="JnInspectionResult">
        <include refid="selectInspectionVo"/>
        WHERE source_order_id = #{sourceOrderId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByTypeAndDate" resultMap="JnInspectionResult">
        <include refid="selectInspectionVo"/>
        WHERE inspection_type = #{type}
        AND inspection_date >= #{startDate}
        AND inspection_date &lt;= #{endDate}
        ORDER BY inspection_date DESC
    </select>

</mapper>
