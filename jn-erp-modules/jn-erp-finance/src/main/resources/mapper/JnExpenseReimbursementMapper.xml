<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.finance.expense.mapper.JnExpenseReimbursementMapper">

    <resultMap id="JnExpenseReimbursementResult" type="com.jn.erp.finance.expense.domain.JnExpenseReimbursement">
        <id property="expenseId" column="expense_id"/>
        <result property="expenseNo" column="expense_no"/>
        <result property="expenseType" column="expense_type"/>
        <result property="amount" column="amount"/>
        <result property="applicant" column="applicant"/>
        <result property="applicantName" column="applicant_name"/>
        <result property="department" column="department"/>
        <result property="expenseDate" column="expense_date"/>
        <result property="reimbursementDate" column="reimbursement_date"/>
        <result property="description" column="description"/>
        <result property="invoiceAttached" column="invoice_attached"/>
        <result property="approver" column="approver"/>
        <result property="approvedTime" column="approved_time"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectExpenseVo">
        SELECT expense_id, expense_no, expense_type, amount,
               applicant, applicant_name, department, expense_date, reimbursement_date,
               description, invoice_attached, approver, approved_time, status, remark,
               create_by, create_time, update_by, update_time
        FROM jn_expense_reimbursement
    </sql>

    <select id="selectByApplicant" parameterType="String" resultMap="JnExpenseReimbursementResult">
        <include refid="selectExpenseVo"/>
        WHERE applicant = #{applicant}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" parameterType="String" resultMap="JnExpenseReimbursementResult">
        <include refid="selectExpenseVo"/>
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

</mapper>
