<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jn.erp.finance.ap.mapper.JnPayablePaymentMapper">

    <resultMap id="JnPayablePaymentResult" type="com.jn.erp.finance.ap.domain.JnPayablePayment">
        <id property="paymentId" column="payment_id"/>
        <result property="payableId" column="payable_id"/>
        <result property="payableNo" column="payable_no"/>
        <result property="paymentNo" column="payment_no"/>
        <result property="paymentDate" column="payment_date"/>
        <result property="amount" column="amount"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="bankAccountId" column="bank_account_id"/>
        <result property="bankAccountName" column="bank_account_name"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectPaymentVo">
        SELECT payment_id, payable_id, payable_no, payment_no, payment_date,
               amount, payment_method, bank_account_id, bank_account_name, remark,
               create_by, create_time, update_by, update_time
        FROM jn_payable_payment
    </sql>

    <select id="selectByPayableId" parameterType="Long" resultMap="JnPayablePaymentResult">
        <include refid="selectPaymentVo"/>
        WHERE payable_id = #{payableId}
        ORDER BY payment_date ASC
    </select>

</mapper>
